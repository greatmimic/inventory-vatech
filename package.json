{
  "name": "vatech-inventory",
  "version": "2.0.0",
  "description": "Internal inventory tracking app",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cross-env PORT=3001 node server.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite build && node server.js",
    "start": "node server.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "express-session": "^1.19.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "vite": "^6.0.7"
  }
}
